# ── Telegram ───────────────────────────────────────────────────────────────
# Token de @BotFather.
TELEGRAM_BOT_TOKEN=
# Chats autorizados (coma-separados). Vacío = el bot rechaza todo y te dice tu
# chat id: escribile /start, copiá el número y pegalo acá.
TELEGRAM_ALLOWED_CHAT_IDS=
# Código para autorizar tu chat la primera vez sin tocar este archivo:
# mandale al bot "/vincular <código>". Sólo funciona mientras no haya
# ningún chat autorizado.
PAIRING_CODE=

# ── Transcripción de audios ────────────────────────────────────────────────
# Opción A (por defecto): API de OpenAI.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=es
# Opción B: transcriptor local. Comando que recibe el path del audio y escribe
# el texto en stdout, ej: WHISPER_LOCAL_CMD="whisper-cli -m /ruta/modelo.bin -nt -f"
# WHISPER_LOCAL_CMD=

# ── Email saliente (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
# Remitente verificado en Resend (ej. bot@tudominio.com)
MAIL_FROM=
# Destinatario por defecto cuando el agente no especifica --to
MAIL_DEFAULT_TO=

# ── Claude Code ────────────────────────────────────────────────────────────
# Usa tu sesión (suscripción MAX): NO definas ANTHROPIC_API_KEY acá.
CLAUDE_BIN=claude
# Modelo opcional (opus / sonnet / haiku). Vacío = el default de tu config.
CLAUDE_MODEL=
# Directorio donde arranca el agente. Vacío = la raíz de este repo.
CLAUDE_CWD=
# Corte de seguridad por pedido (ms). Default 20 min.
CLAUDE_TIMEOUT_MS=1200000

# ── Varios ─────────────────────────────────────────────────────────────────
MAX_AUDIO_MB=25
